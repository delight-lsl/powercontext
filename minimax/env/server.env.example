# PowerContext Server environment for the MiniMax SDD context-management solution.
#
# Every value below is a PLACEHOLDER. Copy this file, replace the placeholders
# with your own values, and keep the filled-in copy outside version control.
#
#   cp minimax/env/server.env.example minimax/.runtime/server.env
#
# The database is an OceanBase / seekdb instance reachable over the MySQL
# protocol. PowerContext requires the official async OceanBase dialect, so the
# URL scheme must stay "mysql+aoceanbase" and must carry an explicit port and
# "charset=utf8mb4".

# --- HTTP listener -----------------------------------------------------------
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8010

# --- Persistent store --------------------------------------------------------
# kind=oceanbase is used for both OceanBase MySQL-mode clusters and standalone
# seekdb 1.4 servers. PowerContext detects a standalone seekdb build from
# VERSION() and skips the multi-tenant compatibility check.
POWERCONTEXT_SERVER_DATABASE_KIND=oceanbase
POWERCONTEXT_SERVER_DATABASE_URL=mysql+aoceanbase://<db-user>:<db-password>@<db-host>:<db-port>/<db-name>?charset=utf8mb4

# --- Local behaviour ---------------------------------------------------------
# "disabled" keeps the loopback-only listener unauthenticated, which is what
# the local verification scripts use. Use "enforced" plus
# POWERCONTEXT_SERVER_AUTH_TOKEN for any shared deployment.
POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_MCP_ENABLED=false
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=false

# --- Runtime data directory --------------------------------------------------
# Holds server identity and cached state. Keep it outside version control.
POWERCONTEXT_HOME=<powercontext-home>
