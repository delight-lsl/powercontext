# Copy to deploy/docker/.env and replace every CHANGE_ME value.
# This example expects the existing seekdb service on the Docker host at 10100.
CONSOLE_API_URL=http://<SERVER_IP>:18080
CONSOLE_WEB_URL=http://<SERVER_IP>:18080
SERVICE_API_URL=http://<SERVER_IP>:18080
APP_API_URL=http://<SERVER_IP>:18080
APP_WEB_URL=http://<SERVER_IP>:18080
FILES_URL=http://<SERVER_IP>:18080
ENDPOINT_URL_TEMPLATE=http://<SERVER_IP>:18080/e/{hook_id}
TRIGGER_URL=http://<SERVER_IP>:18080
NEXT_PUBLIC_SOCKET_URL=ws://<SERVER_IP>:18080

SECRET_KEY=CHANGE_ME_SECRET_KEY
INIT_PASSWORD=
DB_TYPE=mysql
DB_USERNAME=dify
DB_PASSWORD=CHANGE_ME_SEEKDB_PASSWORD
DB_HOST=172.17.0.1
DB_PORT=10100
DB_DATABASE=dify
DB_PLUGIN_DATABASE=dify_plugin

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
CELERY_BACKEND=redis

VECTOR_STORE=seekdb
OCEANBASE_VECTOR_HOST=172.17.0.1
OCEANBASE_VECTOR_PORT=10100
OCEANBASE_VECTOR_USER=dify
OCEANBASE_VECTOR_PASSWORD=CHANGE_ME_SEEKDB_PASSWORD
OCEANBASE_VECTOR_DATABASE=dify
OCEANBASE_ENABLE_HYBRID_SEARCH=false

COMPOSE_PROFILES=collaboration
EXPOSE_NGINX_PORT=18080
SANDBOX_API_KEY=CHANGE_ME_SANDBOX_KEY
CODE_EXECUTION_API_KEY=CHANGE_ME_SANDBOX_KEY
PLUGIN_DAEMON_KEY=CHANGE_ME_PLUGIN_KEY
PLUGIN_DIFY_INNER_API_KEY=CHANGE_ME_INNER_KEY
DIFY_AGENT_API_TOKEN=CHANGE_ME_AGENT_KEY
